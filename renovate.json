{
  "extends": ["config:recommended", "schedule:weekly", "group:allNonMajor"],
  "baseBranchPatterns": ["dev"],
  "ignorePaths": ["poradnia/static/jquery-ui/**"],
  "enabledManagers": [
    "dockerfile",
    "docker-compose",
    "pip_requirements",
    "pip_setup",
    "github-actions",
    "npm"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python", "node"],
      "groupName": null,
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements/dev.txt"],
      "groupName": "non-production-dependencies"
    },
    {
      "matchPackageNames": ["django"],
      "allowedVersions": "^5.2"
    },
    {
      "matchPackageNames": ["celery"],
      "allowedVersions": "<5.7.0"
    },
    {
      "matchPackageNames": ["caniuse-lite"],
      "minimumReleaseAge": null
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": ["/requirements/.+?.txt/"]
  },
  "constraints": {
    "node": ">=26.0.0 < 27.0.0"
  }
}
